#!/usr/bin/env bash
set -euo pipefail

SHARED="$HOME/.agents/skills"
OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
OPENCODE="$OPENCODE_CONFIG_DIR/skills"
CODEX="$HOME/.codex/skills"
SUPERPOWERS_OPENCODE="superpowers@git+https://github.com/obra/superpowers.git"
SUPERPOWERS_CODEX="superpowers@openai-curated"

echo "== Checking environment =="

for cmd in node npm npx; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "ERROR: $cmd not found"
    exit 1
  }
done

if [[ "$(command -v npm)" == /mnt/c/* ]] || [[ "$(command -v npx)" == /mnt/c/* ]]; then
  echo "ERROR: npm/npx are Windows versions."
  echo "Install Linux Node.js inside WSL first."
  echo
  echo "Current:"
  echo "  node: $(command -v node)"
  echo "  npm:  $(command -v npm)"
  echo "  npx:  $(command -v npx)"
  exit 1
fi

mkdir -p "$SHARED" "$OPENCODE" "$CODEX"

echo
echo "== Updating existing skills =="
npx -y skills@latest update -g -y || true

echo
echo "== Matt Pocock skills =="
npx -y skills@latest add mattpocock/skills \
  -g -y \
  -a opencode \
  -a codex \
  --skill setup-matt-pocock-skills \
  --skill ask-matt \
  --skill grilling \
  --skill grill-with-docs \
  --skill domain-modeling \
  --skill codebase-design \
  --skill research \
  --skill prototype \
  --skill handoff \
  --skill to-spec \
  --skill to-tickets \
  --skill code-review \
  --skill wayfinder \
  --skill wait-what \
  --skill wizard \
  --skill writing-for-agents

echo
echo "== Chisel =="
npx -y skills@latest add JacobStephens2/skills \
  -g -y \
  -a opencode \
  -a codex \
  --skill chisel

echo
echo "== Caveman =="
npx -y skills@latest add JuliusBrussee/caveman \
  -g -y \
  -a opencode \
  -a codex \
  --skill caveman

echo
echo "== Context7 =="
npm install -g ctx7@latest

npx -y skills@latest add \
  https://github.com/upstash/context7/tree/master/skills/context7-cli \
  -g -y \
  -a opencode \
  -a codex

echo
echo "== Playwright CLI =="
npm install -g @playwright/cli@latest
playwright-cli install --skills=agents --global

echo
echo "== Syncing skills =="

for skill in "$SHARED"/*; do
  [[ -d "$skill" ]] || continue
  [[ -f "$skill/SKILL.md" ]] || continue

  name="$(basename "$skill")"

  rm -rf "$OPENCODE/$name"
  rm -rf "$CODEX/$name"

  ln -s "$skill" "$OPENCODE/$name"
  ln -s "$skill" "$CODEX/$name"
done

echo
echo "== Installed skills =="

find "$SHARED" \
  -maxdepth 2 \
  -name SKILL.md \
  -printf '%h\n' \
  | sed "s|$SHARED/||" \
  | sort

echo
echo "Done."
echo
echo "Restart OpenCode and Codex."
echo "Shared skills: $SHARED"
echo "Superpowers for Codex: install as a plugin."
echo
echo "OpenCode Superpowers (one-time manual setup):"
echo "  Edit: $OPENCODE_CONFIG_DIR/opencode.json (or opencode.jsonc)"
echo '  Add to the top-level "plugin" array:'
echo "    \"$SUPERPOWERS_OPENCODE\""
